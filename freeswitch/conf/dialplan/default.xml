<?xml version="1.0" encoding="UTF-8"?>
<include>
  <context name="default">

    <!-- Teste de eco: disque 9196 para confirmar que o registro está funcionando. Fica ANTES de
         zenith_call_context (sem break/continue entre eles) e responde/encerra sozinha, então
         9196 nunca ganha zenith_* nem é gravada — comportamento intencional, é diagnóstico de
         rede, não chamada de condomínio (GAP-RE-03, 2026-08-24). -->
    <extension name="echo_test">
      <condition field="destination_number" expression="^9196$">
        <action application="answer"/>
        <action application="echo"/>
      </condition>
    </extension>

    <!-- Contexto Zenith para ramal local (GAP-RE-03, 2026-08-24): ramais de condomínio
         (1\d{3}, bridge direto em local_extension) não passavam por nenhuma extension que
         setasse zenith_*, então nenhuma chamada ramal-a-ramal gerava linha Call nem era
         gravada/transcrita. continue="true" aqui NÃO bridgeia nem responde a chamada — só seta
         variável e deixa o dialplan seguir procurando. Precisa vir ANTES de local_extension:
         bridge é bloqueante, então setar as variáveis depois (ex: continue="true" direto em
         local_extension, correndo esta lógica só depois do bridge retornar) as populariam tarde
         demais para o guard do CHANNEL_ANSWER em esl_client.py. Mesma lógica de guarda de
         zenith_audio_fork (linhas abaixo), duplicada aqui de propósito: não pode virar helper
         compartilhado sem reordenar zenith_audio_fork também, fora do escopo deste fix. -->
    <extension name="zenith_call_context" continue="true">
      <condition field="destination_number" expression="^(\d+)$" break="never">
        <action application="set" data="zenith_call_id=${uuid}"/>
        <action application="set" data="zenith_agent_extension=${sip_from_user}"/>
      </condition>
      <condition field="${zenith_tenant_id}" expression="^$" break="never">
        <action application="set" data="zenith_tenant_id=$${tenant_id}"/>
        <action application="set" data="zenith_pbx_id=$${pbx_id}"/>
      </condition>
    </extension>

    <!-- Chamadas entre ramais registrados localmente (condomínio) -->
    <extension name="local_extension">
      <condition field="destination_number" expression="^(1\d{3})$">
        <action application="bridge" data="user/$1@$${domain}"/>
      </condition>
    </extension>

    <extension name="zenith_audio_fork">
      <condition field="destination_number" expression="^(\d+)$">
        <action application="set" data="zenith_call_id=${uuid}"/>
        <action application="set" data="zenith_agent_extension=${sip_from_user}"/>
      </condition>
      <!-- Fallback de contexto (RN-11/D-15, 2026-08-12): zenith_tenant_id/zenith_pbx_id só são
           setados aqui quando o canal ainda não os tem. Troncos ATA já chegam com essas variáveis
           injetadas pelo diretório dinâmico (mod_xml_curl, ver src/api/freeswitch_directory.py) e
           não podem ser sobrescritos. break="never" é obrigatório: sem ele, quando o tronco já
           tem zenith_tenant_id (condição não casa "^$"), o FreeSWITCH aborta o resto da extensão
           e a chamada nunca chega em answer/bridge. -->
      <condition field="${zenith_tenant_id}" expression="^$" break="never">
        <action application="set" data="zenith_tenant_id=$${tenant_id}"/>
        <action application="set" data="zenith_pbx_id=$${pbx_id}"/>
      </condition>
      <condition field="destination_number" expression="^(\d+)$">
        <action application="answer"/>
        <action application="start_dtmf"/>
        <action application="bridge" data="sofia/gateway/upstream-${sip_from_user}/${destination_number}"/>
      </condition>
    </extension>

    <extension name="manual_linkage">
      <condition field="destination_number" expression="^\*88$">
        <action application="answer"/>
        <action application="log" data="INFO Manual linkage request from ${sip_from_user} at ${sip_from_host}"/>
        <action application="playback" data="tone_stream://%%(100,0,440)"/>
        <action application="sleep" data="500"/>
        <action application="hangup"/>
      </condition>
    </extension>

    <extension name="playback_filler">
      <condition field="destination_number" expression="^play:filler$">
        <action application="answer"/>
        <action application="playback" data="${sound_prefix}/zenith/filler.wav"/>
      </condition>
    </extension>

  </context>
</include>
