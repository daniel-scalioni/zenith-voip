# -------------------------------------------------------
# Exemplo de configuração — copie para .env e ajuste
# -------------------------------------------------------

# ip-watcher (sidecar de detecção dinâmica de IP externo)
# -------------------------------------------------------
# URL do endpoint HTTP/HTTPS que retorna o IP público do CPD (texto puro, ex.: "200.170.149.139")
# Pode ser um serviço público (api.ipify.org, ifconfig.me) ou endpoint próprio
EXTERNAL_IP_ENDPOINT=https://api.ipify.org

# Senha ESL do FreeSWITCH — deve coincidir com event_socket.conf.xml
FREESWITCH_ESL_PASSWORD=ClueCon

# Intervalo de polling em segundos (default 60)
POLL_INTERVAL=60

# Somente dev: quando definido, bypassa o endpoint HTTP e usa este IP fixo
# MOCK_EXTERNAL_IP=189.112.222.244

# Backup de áudio em storage SMB
# -------------------------------------------------------
SMB_ENABLED=false
SMB_HOST=
SMB_PORT=445
SMB_IS_DIRECT_TCP=true
SMB_CLIENT_NAME=ZENITH
SMB_SERVER_NAME=
SMB_DOMAIN=
SMB_USE_NTLM_V2=true
SMB_SIGN_OPTIONS=2
SMB_SHARE=
SMB_PATH=
SMB_USERNAME=
SMB_PASSWORD=
SMB_BANDWIDTH_LIMIT_MBS=5
SMB_TRANSFER_LOG_PATH=/data/smb_logs/smb_transfer_log.json
SMB_SYNC_INTERVAL_MINUTES=5
TRANSCRIPT_ENABLED=true
TRANSCRIPT_CHUNK_SECONDS=30
TRANSCRIPT_CALL_TIMEOUT_SECONDS=3600
TRANSCRIPT_CYCLE_TIMEOUT_SECONDS=86400
TRANSCRIPT_SYNC_INTERVAL_MINUTES=2
WHISPER_CPP_LANGUAGE=pt
WHISPER_CPP_THREADS=1

# Registro de troncos ATA / diretório dinâmico FreeSWITCH
# -------------------------------------------------------
# Uma ou mais chaves Fernet separadas por vírgula. Gere valores privados;
# nunca copie uma chave real para este arquivo ou para specs/logs.
TRUNK_CREDENTIAL_KEYS=
ZENITH_POSTGRES_PASSWORD=replace-with-private-password
ZENITH_CANDIDATE_POSTGRES_PASSWORD=replace-with-private-password  # só docker-compose.candidate.yml (rehearsal), não é o banco de produção
DATABASE_URL=postgresql+asyncpg://zenith:URL_ENCODED_PASSWORD@postgres:5432/zenith

# HTTP Basic exclusivo do mod_xml_curl. Diferente de JWT e da senha ESL.
FREESWITCH_DIRECTORY_BASIC_USERNAME=
FREESWITCH_DIRECTORY_BASIC_PASSWORD=

# Callback acessível somente pelo loopback do host do FreeSWITCH.
FREESWITCH_DIRECTORY_URL=http://127.0.0.1:8001/internal/freeswitch/directory
FREESWITCH_DIRECTORY_TIMEOUT_SECONDS=2

# Diretório legado privado, montado read-only na API que serve o XML Curl.
LEGACY_DIRECTORY_PATH=/run/zenith-directory/extensions.xml
