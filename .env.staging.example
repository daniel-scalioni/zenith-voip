# ── Zenith AI Audio Hub — Staging ──────────────────────────
# Copie este arquivo para .env.staging e preencha os valores.

DEEPGRAM_API_KEY=
JWT_SECRET=change-me-in-production

LOG_LEVEL=DEBUG

REDIS_URL=redis://redis:6379/0
ZENITH_CANDIDATE_POSTGRES_PASSWORD=replace-with-private-password
DATABASE_URL=postgresql+asyncpg://zenith_candidate:URL_ENCODED_PASSWORD@postgres:5432/zenith_candidate

FREESWITCH_ESL_HOST=172.20.0.1
FREESWITCH_ESL_PORT=8021

OLLAMA_URL=http://ollama:11434
PIPER_TTS_URL=http://piper-tts:5000

AUDIO_RETENTION_DAYS=90
RECORDINGS_PATH=/data/recordings
